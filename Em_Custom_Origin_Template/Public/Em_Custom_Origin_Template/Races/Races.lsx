<?xml version="1.0" encoding="UTF-8"?>
<save>
    <version major="4" minor="7" revision="1" build="1"/>
    <region id="Races">
        <node id="root">
            <children>
                <node id="Race"> <!-- This node merges John's custom hair color into the Human race so it will be pickable in CC. Swap and copy this node for custom colors as needed. -->
                    <attribute id="MergedInto" type="guid" value="0eb594cb-8820-4be6-a58d-8be7a1a98fba"/> <!-- Human race UUID -->
                    <attribute id="Name" type="FixedString" value="Human"/> <!-- Internal name -->
                    <attribute id="UUID" type="guid" value="85218256-1ed2-4490-84fd-caae624057cf"/> <!-- Regenerate this! -->
                    <children>
                        <node id="HairColors">
                            <attribute id="Object" type="guid" value="6f7cad74-266c-4da3-bfe2-6f0698d0da12"/> 
							<!-- This needs to match the UUID guid value in the CharacterCreationHairColors entry -->
                        </node>
                    </children>
                </node>
            </children>
        </node>
    </region>
</save>
